page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.btn-primary {
  background: #2b6cb0;
  color: #fff;
  border-radius: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.tag-green { background: #e6fffa; color: #2c7a7b; }
.tag-orange { background: #fffaf0; color: #c05621; }
.tag-gray { background: #edf2f7; color: #4a5568; }
.tag-blue { background: #ebf8ff; color: #2b6cb0; }
