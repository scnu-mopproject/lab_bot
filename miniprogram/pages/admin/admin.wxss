.seg { display: flex; background: #fff; border-radius: 12rpx; padding: 6rpx; margin-bottom: 20rpx; }
.seg-i { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 10rpx; font-size: 24rpx; color: #666; }
.seg-on { background: #2b6cb0; color: #fff; }
.sub-seg { margin: 20rpx 0; }
.card.warn { border: 1rpx solid #f0c36d; background: #fffbf0; }

/* 看板 KPI */
.kpis { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.kpi { width: calc((100% - 16rpx) / 2); box-sizing: border-box; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.kpi-num { font-size: 48rpx; font-weight: 700; color: #2b6cb0; }
.kpi-lb { color: #888; font-size: 24rpx; margin-top: 6rpx; }

/* 列表行 */
.ln { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.ln:last-child { border-bottom: none; }
.ln-main { font-size: 27rpx; }
.sm { font-size: 22rpx; }
.add { color: #2b6cb0; font-weight: 600; font-size: 26rpx; }

/* 条形统计 */
.bar-row { display: flex; align-items: center; margin: 14rpx 0; }
.bar-lb { width: 100rpx; font-size: 22rpx; color: #555; }
.bar-lb.wide { width: 200rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bar-bg { flex: 1; height: 18rpx; background: #edf2f7; border-radius: 9rpx; margin: 0 14rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 9rpx; min-width: 4rpx; }
.bar-blue { background: #2b6cb0; }
.bar-green { background: #38a169; }
.bar-orange { background: #dd6b20; }
.bar-val { width: 48rpx; text-align: right; font-size: 22rpx; color: #333; }
.hint { margin-bottom: 16rpx; }
.empty { text-align: center; margin-top: 80rpx; }
.btns { margin-top: 20rpx; gap: 20rpx; justify-content: flex-start; }
.approve { background: #2b6cb0; color: #fff; padding: 12rpx 40rpx; border-radius: 30rpx; }
.reject { border: 1rpx solid #e53e3e; color: #e53e3e; padding: 12rpx 40rpx; border-radius: 30rpx; }
.field { margin: 20rpx 0; }
.date-pick { color: #2b6cb0; }
.mode-seg { display: flex; border: 1rpx solid #2b6cb0; border-radius: 8rpx; overflow: hidden; }
.mode-i { padding: 8rpx 28rpx; font-size: 24rpx; color: #2b6cb0; }
.mode-on { background: #2b6cb0; color: #fff; }
.link { color: #2b6cb0; font-size: 26rpx; margin: 12rpx 0; }
.input { border: 1rpx solid #e2e8f0; border-radius: 10rpx; padding: 18rpx; margin: 14rpx 0; }
.area { height: 160rpx; }
.upload { background: #edf2f7; color: #2b6cb0; border-radius: 10rpx; margin: 16rpx 0; }
.result { margin-top: 20rpx; }
.del { color: #e53e3e; font-size: 24rpx; }

/* 成员管理 */
.search-bar { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.search-ipt { flex: 1; background: #fff; border-radius: 10rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.search-btn { background: #2b6cb0; color: #fff; border-radius: 10rpx; padding: 16rpx 28rpx; font-size: 26rpx; }
.mb { margin-bottom: 16rpx; }
.role-tag { margin-left: 12rpx; }
.lock { margin-left: 8rpx; font-size: 22rpx; }
.mbtn { padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; }
.mbtn-on { background: #2b6cb0; color: #fff; }
.mbtn-off { border: 1rpx solid #e53e3e; color: #e53e3e; }
