<view class="container">
  <view class="seg">
    <view class="seg-i {{tab===t.k?'seg-on':''}}" wx:for="{{tabs}}" wx:for-item="t" wx:key="k"
          data-k="{{t.k}}" bindtap="switchTab">{{t.label}}</view>
  </view>

  <!-- 看板 -->
  <block wx:if="{{tab==='dashboard'}}">
    <view class="kpis" wx:if="{{dashboard}}">
      <view class="kpi"><view class="kpi-num">{{dashboard.summary.pending_bookings}}</view><view class="kpi-lb">待审批预约</view></view>
      <view class="kpi"><view class="kpi-num">{{dashboard.summary.open_repairs}}</view><view class="kpi-lb">待维修设备</view></view>
      <view class="kpi"><view class="kpi-num">{{dashboard.summary.today_bookings}}</view><view class="kpi-lb">今日预约</view></view>
      <view class="kpi"><view class="kpi-num">{{dashboard.summary.active_rooms}}</view><view class="kpi-lb">开放实验室</view></view>
    </view>

    <view class="card" wx:if="{{dashboard}}">
      <view class="title">待审批预约</view>
      <view class="ln" wx:for="{{dashboard.pending_bookings}}" wx:key="id">
        <view class="row"><text class="ln-main">{{item.room_name}}</text><text class="muted">{{item.user_name}}</text></view>
        <view class="muted sm">{{item.start_time}} ~ {{item.end_time}}</view>
      </view>
      <view class="muted sm" wx:if="{{dashboard.pending_bookings.length===0}}">暂无待审批</view>
    </view>

    <view class="card" wx:if="{{dashboard}}">
      <view class="title">待维修设备</view>
      <view class="bar-row" wx:for="{{repairBars}}" wx:key="key">
        <text class="bar-lb">{{item.label}}</text>
        <view class="bar-bg"><view class="bar-fill {{item.key==='done'||item.key==='closed'?'bar-green':'bar-blue'}}" style="width:{{item.pct}}%"></view></view>
        <text class="bar-val">{{item.count}}</text>
      </view>
      <view class="ln" wx:for="{{dashboard.pending_repairs}}" wx:key="id" bindtap="goRepair" data-id="{{item.id}}">
        <view class="row"><text class="ln-main">{{item.device_name}}</text><text class="tag tag-blue">{{statusText[item.status]}}</text></view>
        <view class="muted sm">{{item.room_name}} · {{item.created_at}}</view>
      </view>
    </view>

    <view class="card" wx:if="{{dashboard}}">
      <view class="title">高频咨询问题（近30天）</view>
      <view class="bar-row" wx:for="{{dashboard.hot_questions}}" wx:key="question">
        <text class="bar-lb wide">{{item.question}}</text>
        <view class="bar-bg"><view class="bar-fill bar-orange" style="width:{{item.pct}}%"></view></view>
        <text class="bar-val">{{item.count}}</text>
      </view>
      <view class="muted sm" wx:if="{{dashboard.hot_questions.length===0}}">暂无咨询数据</view>
    </view>

    <view class="card" wx:if="{{dashboard && dashboard.room_usage.length}}">
      <view class="title">实验室使用热度（近30天）</view>
      <view class="bar-row" wx:for="{{dashboard.room_usage}}" wx:key="room_name">
        <text class="bar-lb wide">{{item.room_name}}</text>
        <view class="bar-bg"><view class="bar-fill bar-blue" style="width:{{item.pct}}%"></view></view>
        <text class="bar-val">{{item.count}}</text>
      </view>
    </view>
  </block>

  <!-- 成员管理 -->
  <block wx:if="{{tab==='member'}}">
    <view class="search-bar">
      <input class="search-ipt" placeholder="搜索姓名 / 学工号" value="{{memberKeyword}}"
             bindinput="onMemberSearch" confirm-type="search" bindconfirm="searchMembers" />
      <view class="search-btn" bindtap="searchMembers">搜索</view>
    </view>
    <view class="muted hint">白名单成员（标记 🔒）由 ADMIN_SSO_IDS 配置控制，不可在此降级</view>
    <view class="card mb" wx:for="{{members}}" wx:key="id">
      <view class="row">
        <view>
          <view class="ln-main">{{item.name}}
            <text class="tag {{item.role==='admin'?'tag-blue':'tag-gray'}} role-tag">{{roleText[item.role]}}</text>
            <text wx:if="{{item.is_whitelisted}}" class="lock">🔒</text>
          </view>
          <view class="muted sm">{{item.sso_id}}{{item.college ? ' · ' + item.college : ''}}</view>
        </view>
        <view class="mbtn {{item.role==='admin'?'mbtn-off':'mbtn-on'}}"
              data-id="{{item.id}}" data-sso="{{item.sso_id}}" data-admin="{{item.role==='admin'}}"
              data-lock="{{item.is_whitelisted}}" bindtap="toggleAdmin">
          {{item.role==='admin' ? '取消管理员' : '设为管理员'}}
        </view>
      </view>
    </view>
    <view class="muted empty" wx:if="{{members.length===0}}">无成员</view>
  </block>

  <!-- 报表导出 -->
  <block wx:if="{{tab==='report'}}">
    <view class="card">
      <view class="title">报表导出</view>
      <view class="muted sm">按时间段筛选并导出 Excel，可在微信内预览或转发保存</view>
      <view class="seg sub-seg">
        <view class="seg-i {{report.type===rt.k?'seg-on':''}}" wx:for="{{reportTypes}}" wx:for-item="rt" wx:key="k"
              data-k="{{rt.k}}" bindtap="pickReportType">{{rt.label}}</view>
      </view>
      <view class="row field"><text>起始日期</text>
        <picker mode="date" value="{{report.start}}" bindchange="onReportStart"><view class="date-pick">{{report.start}} ›</view></picker>
      </view>
      <view class="row field"><text>结束日期</text>
        <picker mode="date" value="{{report.end}}" bindchange="onReportEnd"><view class="date-pick">{{report.end}} ›</view></picker>
      </view>
      <button class="btn-primary" bindtap="exportReport">导出 Excel</button>
    </view>
  </block>

  <!-- 预约审批 -->
  <block wx:if="{{tab==='booking'}}">
    <view class="muted hint">仅显示待审批预约（自动审批开启时通常为空）</view>
    <view class="card" wx:for="{{bookings}}" wx:key="id">
      <view class="row"><view class="title">{{item.room_name}}</view><view class="tag tag-orange">待审批</view></view>
      <view class="muted">{{item.user_name}} · {{item.start_time}} ~ {{item.end_time}}</view>
      <view class="muted" wx:if="{{item.purpose}}">用途：{{item.purpose}}</view>
      <view class="row btns">
        <view class="approve" data-id="{{item.id}}" bindtap="review" data-ok="true">通过</view>
        <view class="reject" data-id="{{item.id}}" bindtap="review" data-ok="false">驳回</view>
      </view>
    </view>
    <view class="muted empty" wx:if="{{bookings.length===0}}">暂无待审批预约</view>
  </block>

  <!-- 报修流转 -->
  <block wx:if="{{tab==='repair'}}">
    <view class="card" wx:for="{{repairs}}" wx:key="id" bindtap="goRepair" data-id="{{item.id}}">
      <view class="row"><view class="title">{{item.device_name}}</view><view class="tag tag-blue">{{statusText[item.status]}}</view></view>
      <view class="muted">{{item.room_name}} · {{item.reporter_name}}</view>
      <view class="muted">点击进入处理 ›</view>
    </view>
    <view class="muted empty" wx:if="{{repairs.length===0}}">暂无报修工单</view>
  </block>

  <!-- 课表导入 -->
  <block wx:if="{{tab==='schedule'}}">
    <view class="card">
      <view class="title">批量导入课表</view>
      <view class="muted">上传 CSV/Excel，列：room_name, weekday, start_period, end_period, start_week, end_week, course_name</view>
      <view class="row field"><text>学期第一周周一</text>
        <picker mode="date" value="{{termStart}}" bindchange="onTermStart"><view class="date-pick">{{termStart}} ›</view></picker>
      </view>
      <button class="upload" bindtap="chooseFile">{{fileName || '选择课表文件'}}</button>
      <button class="btn-primary" bindtap="doImport" wx:if="{{filePath}}">开始导入</button>
      <view class="result" wx:if="{{importResult}}">
        <view>新增 {{importResult.created}} 条，跳过 {{importResult.skipped}} 条</view>
        <view class="muted" wx:for="{{importResult.conflicts}}" wx:key="*this">{{item}}</view>
      </view>
    </view>
  </block>

  <!-- FAQ 知识库 + 知识文档 -->
  <block wx:if="{{tab==='faq'}}">
    <view class="card" bindtap="goDocuments">
      <view class="row"><view class="title">知识文档（智能问答）</view><view class="add">管理文档 ›</view></view>
      <view class="muted sm">共 {{docTotal}} 个文档 · 支持 txt/md/pdf/docx/xlsx 及 zip 批量上传，机器人会引用其内容作答</view>
    </view>

    <view class="card">
      <view class="title">新增 FAQ</view>
      <input class="input" placeholder="问题" value="{{faqForm.question}}" bindinput="onFaq" data-k="question" />
      <textarea class="input area" placeholder="答案" value="{{faqForm.answer}}" bindinput="onFaq" data-k="answer" />
      <input class="input" placeholder="关键词（逗号分隔，选填）" value="{{faqForm.keywords}}" bindinput="onFaq" data-k="keywords" />
      <button class="btn-primary" bindtap="addFaq">保存</button>
    </view>
    <view class="card" wx:for="{{faqs}}" wx:key="id">
      <view class="row"><view class="title">{{item.question}}</view><view class="del" data-id="{{item.id}}" bindtap="delFaq">删除</view></view>
      <view class="muted">{{item.answer}}</view>
    </view>
  </block>
</view>
