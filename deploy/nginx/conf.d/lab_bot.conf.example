# lab_bot 反向代理 + HTTPS 配置示例
# 用法：备案通过、拿到证书后，
#   1) cp lab_bot.conf.example lab_bot.conf
#   2) 把 your.domain.com 改成你的真实域名
#   3) 把证书放到 ../certs/（见下方 ssl_certificate 路径）
#   4) docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
#
# 说明：nginx 与后端在同一个 compose 网络里，用服务名 backend 直连其 8000 端口。

# HTTP：用于证书校验 + 强制跳转 HTTPS
server {
    listen 80;
    server_name your.domain.com;

    # Let's Encrypt（certbot）签发时用；用腾讯云免费证书可忽略此段
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS：真正对外的入口
server {
    listen 443 ssl;
    http2 on;
    server_name your.domain.com;

    # 证书文件放在宿主机 deploy/nginx/certs/，容器内映射到 /etc/nginx/certs/
    # 腾讯云下载的 Nginx 版证书一般是 xxx_bundle.crt 与 xxx.key，
    # 重命名为下面两个文件名即可（或改这里的路径）。
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 文档/课表上传需要较大请求体
    client_max_body_size 50m;

    location / {
        proxy_pass         http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
