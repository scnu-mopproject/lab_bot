# ============================================================
# Docker 部署用环境变量示例
# 用法：在服务器上 cp backend/.env.docker.example backend/.env 后按需修改
#
# 说明：
# - DATABASE_URL 不要在这里设置；镜像已固定指向数据卷 /app/data/lab_bot.db。
# - 自测阶段保持 *_MOCK=true 即可；对外正式上线再关闭并填真实凭据。
# ============================================================

# ===== 基础 =====
APP_NAME=lab_bot
# 自测可保持默认；对外务必改成随机长字符串（如 openssl rand -hex 32）
JWT_SECRET=change-me-please
JWT_EXPIRE_MINUTES=10080

# ===== 微信小程序（自测用 mock，无需真实 appid/secret）=====
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

# ===== 学校统一认证（华师统一身份认证 OAuth2，自测用 mock）=====
# 三档环境只改这里即可切换：mock(本地) -> 测试 -> 生产
SSO_MOCK=true
# [认证服务地址]：生产 https://sso.scnu.edu.cn/AccountService；测试环境地址以审批回执邮件为准
SSO_BASE_URL=https://sso.scnu.edu.cn/AccountService
# 回调地址 redirect_uri：上线后填已备案的 https 域名，须在 SSO 登记域名下
SSO_SERVICE_URL=http://YOUR_SERVER_IP:8000/api/auth/sso/callback
# 接入申请通过后由统一认证平台分配
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_APPLET_ID=

# ===== 预约策略 =====
BOOKING_AUTO_APPROVE=true

# ===== 管理员白名单（命中即自动成为 admin）=====
ADMIN_SSO_IDS=admin

# ===== AI 咨询（默认 mock；接通义千问示例见下）=====
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#   LLM_API_KEY=sk-你的百炼APIKey

# ===== 文档问答 RAG 向量化（默认本地离线）=====
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
