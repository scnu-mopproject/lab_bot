# ===== 基础 =====
APP_NAME=lab_bot
DATABASE_URL=sqlite:///./lab_bot.db
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=10080

# ===== 微信小程序 =====
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret
WECHAT_MOCK=true

# ===== 学校统一认证 (华师统一身份认证平台 / OAuth2.0) =====
# 三档环境只改这里即可切换：mock(本地) -> 测试 -> 生产
SSO_MOCK=true
# [认证服务地址]：生产 https://sso.scnu.edu.cn/AccountService；测试环境地址以审批回执邮件为准
SSO_BASE_URL=https://sso.scnu.edu.cn/AccountService
# 回调地址 redirect_uri：须在 SSO 登记的域名下、完整 URL、最好不带参数
SSO_SERVICE_URL=https://your-backend.example.com/api/auth/sso/callback
# 接入申请通过后由统一认证平台分配
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 微信小程序 APPID（小程序登录场景需要；通常与 WECHAT_APPID 相同）
SSO_APPLET_ID=

# ===== 预约策略 =====
BOOKING_AUTO_APPROVE=true

# ===== 管理员白名单 =====
# 逗号分隔的学号/工号，命中者登录即自动成为 admin（解决"第一个管理员从哪来"）
ADMIN_SSO_IDS=admin

# ===== AI 咨询（生成回答）=====
# 可选 provider: mock | claude | openai-compatible
# 通义千问示例（去掉注释并填 key 即可）：
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#   LLM_API_KEY=sk-你的百炼APIKey
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 文档问答 RAG 向量化（检索）=====
# provider: local(默认,离线零依赖) | bge(本地中文模型) | openai-compatible(云端)
# 通义千问 embedding 示例：
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL=text-embedding-v3
#   EMBEDDING_API_KEY=sk-你的百炼APIKey
# 切换 EMBEDDING_PROVIDER 后需调用 /api/admin/documents/reindex 重建索引
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
